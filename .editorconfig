# .editorconfig — cKunAgentSSH 基础格式约定
#
# 只声明缩进、编码、末尾换行与行尾空白；命名约定、目录职责和验证命令见
# README「项目结构与工程约定」，前端视觉/组件硬规则见 DESIGN.md，
# 术语口径见 CONTEXT.md，后端 lint 规则见 backend/ruff.toml。
#
# 刻意不设 end_of_line：仓库存量源文件是 CRLF / LF 混合（约 190 / 275），
# 强制任一值会让编辑器在保存旧文件时重写整个文件，产生淹没功能改动的全量 diff。
# 约定是：新文件与新增内容统一 LF，存量不做一次性转换；待专门窗口归一化后再启用该键。

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.md]
# Markdown 行尾两个空格是硬换行语义，不能裁掉
trim_trailing_whitespace = false
