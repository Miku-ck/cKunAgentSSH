# Build artifacts
*.tsbuildinfo

# 本地 PowerShell shim（不入库）
_bin/

# pytest 临时缓存目录（WinError 5 残留，勿提交）
pytest-cache-files-*/

# 安全删除的回收备份目录（勿提交）
.trash-cleanup-*/
backend/tests/_tmp/
backend/_tmp/

# 内嵌 Python 运行时内容（体积大，本地准备，勿提交）
runtime/

# pytest / ruff 缓存目录
.pytest_cache/
.ruff_cache/

# scripts/package.js 生成的临时构建配置
.electron-builder.runtime.yml

# 一次性诊断脚本输出（生成器在 .workbuddy/ 下，勿入库）
.scope-selectors-report.txt

# brainstorm visual companion mockups
.superpowers/

# UI 概念稿与核对截图（与 .superpowers/ 同性质的一次性产物，别混进提交）
designs/

# 直接对 vitest.config.ts 跑 tsc 留下的编译孪生文件 —— vite 找配置时 .js 排在 .ts 前面，
# 留着就等于让测试读一份会过期的旧配置
vitest.config.js
vitest.config.d.ts

# 一次性打包体积诊断脚本（本地探查 node_modules/asar 用，非构建链路，勿入库）
.asarcheck.cjs
.sizeprobe.cjs

# 本地安全审计备份与基准测试目录（一次性产物，勿入库）
.audit-backup-*/
.benchmarks/

# 用 -c.directories.output= 试打包时落在仓库根的替代产物目录（330 MB 量级，
# 每个都含完整 electron 运行时）；正式的 dist/ 已在上面忽略
dist-*/
dist2/

# 本地双击启动 dev 的批处理壳（只为绕开本机 ELECTRON_RUN_AS_NODE 污染，非团队协作链路）
start-dev.cmd

# 启动根因探针遗留目录（default_app.asar 被 SYSTEM/杀软持锁 EBUSY，删不掉；
# 重启后可物理删除，在此之前先忽略，防止探针产物混进提交）
aclprobe/
tmpedist/

# SDD 执行工作区与启动审计临时脚本（spec 2026-10-23 审计打点阶段自产，不入库）
.superpowers/
_perf/

# 代理工具运行产物（hook 状态、发现台账、会话配置，均本地生成勿入库）
.mimosa/
.zcode/
.atomcode/
.review_diff*.txt
