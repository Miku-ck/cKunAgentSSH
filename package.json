{
  "name": "cKunAgentSSH",
  "version": "0.1.0",
  "description": "SSH 智能运维终端 — AI 驱动的远程服务器管理工具",
  "author": "ckun",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.cjs dev --noSandbox",
    "dev:web": "cmd /c \"set VITE_HOST=0.0.0.0&& node scripts/dev.cjs dev --noSandbox\"",
    "dev:web:unix": "VITE_HOST=0.0.0.0 node scripts/dev.cjs dev --noSandbox",
    "build": "electron-vite build",
    "typecheck": "vue-tsc -p tsconfig.web.json --noEmit && vue-tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:backend": "cd backend && python -m pytest tests/ -q",
    "ci": "bash scripts/ci-check.sh",
    "preview": "node scripts/dev.cjs preview",
    "dev:backend": "cd backend && python main.py --host 0.0.0.0",
    "clean": "node scripts/clean.mjs",
    "prepackage": "electron-vite build",
    "package": "node scripts/package.js",
    "postinstall": "node scripts/rebuild-native.cjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.11",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "highlight.js": "^11.11.1",
    "js-yaml": "^5.2.0",
    "marked": "^18.0.5",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.1",
    "vue": "^3.5.16",
    "vue-tsc": "^2.2.12"
  }
}
