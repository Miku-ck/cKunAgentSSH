{
  "name": "cKunAgentSSH",
  "version": "0.1.0",
  "description": "SSH 智能运维终端 — AI 驱动的远程服务器管理工具",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "cmd /c \"set VITE_HOST=0.0.0.0&& electron-vite dev\"",
    "dev:web:unix": "VITE_HOST=0.0.0.0 electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc -p tsconfig.web.json --noEmit && vue-tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:backend": "cd backend && python -m pytest -q",
    "ci": "bash scripts/ci-check.sh",
    "preview": "electron-vite preview",
    "dev:backend": "cd backend && python main.py --host 0.0.0.0",
    "package": "node scripts/package.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "js-yaml": "^5.2.0",
    "marked": "^18.0.5",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "pinia": "^3.0.2",
    "ssh2": "^1.17.0",
    "vue": "^3.5.16"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.1",
    "vue-tsc": "^2.2.12"
  }
}
