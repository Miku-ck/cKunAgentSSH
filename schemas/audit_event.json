{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ckunagentssh:audit-event:1.1",
  "title": "Execution audit event",
  "description": "命令执行决策的审计事件，覆盖权限白名单拒绝与放行两类结果。",
  "$comment": "序列化约定：一条事件一行（JSONL），只追加不修改。integrity 可选：最小可用档案可省略；一旦启用哈希链，prev_hash / record_hash / signature 必须同时提供。新增 reason_code 需提升 schema_version。",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "ts",
    "env",
    "event_type",
    "actor",
    "command",
    "decision",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1",
      "description": "本 schema 的版本。字段语义变化或枚举扩容时提升。"
    },
    "event_id": {
      "$ref": "#/$defs/ulid",
      "description": "事件唯一标识，ULID，按时间可排序。"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "单写者内的单调序号，用于时钟回拨时兜底排序。"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]00:00)$",
      "description": "UTC 时间戳，RFC 3339，建议毫秒精度。"
    },
    "env": {
      "type": "string",
      "minLength": 1,
      "examples": ["prod", "staging", "dev", "test"],
      "description": "事件发生的环境。"
    },
    "event_type": {
      "enum": ["exec.denied", "exec.allowed"],
      "description": "拒绝或放行。"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "host": {
      "$ref": "#/$defs/host"
    },
    "command": {
      "$ref": "#/$defs/command"
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "allOf": [
    {
      "description": "拒绝事件：判定必须是 deny，且明确没有任何执行副作用。",
      "if": {
        "properties": {
          "event_type": {
            "const": "exec.denied"
          }
        },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "result": {
                "const": "deny"
              }
            },
            "required": ["result"]
          },
          "outcome": {
            "properties": {
              "executed": {
                "const": false
              },
              "terminal_written": {
                "const": false
              },
              "side_effects": {
                "const": "none"
              },
              "exit_code": {
                "const": null
              }
            },
            "required": [
              "executed",
              "terminal_written",
              "side_effects",
              "exit_code"
            ]
          }
        }
      }
    },
    {
      "description": "放行事件：判定必须是 allow。",
      "if": {
        "properties": {
          "event_type": {
            "const": "exec.allowed"
          }
        },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "result": {
                "const": "allow"
              }
            },
            "required": ["result"]
          }
        }
      }
    },
    {
      "description": "以解释器输入不透明为由拒绝时，必须说明不透明输入的来源。",
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "reason_code": {
                "const": "OPAQUE_INTERPRETER_INPUT"
              }
            },
            "required": ["reason_code"]
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "command": {
            "required": ["indirection", "opaque_inputs"]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "带算法前缀的小写十六进制 SHA-256 摘要。"
    },
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "26 位 Crockford Base32 ULID。"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["agent", "human", "service"],
          "description": "发起者类型。"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "稳定身份标识，不用显示名。"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "description": "会话标识，用于把同一轮 Agent 的多条事件串起来。"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "description": "触发本次执行的工具名，如 Bash、shell_exec。"
        },
        "tool_call_id": {
          "type": "string",
          "minLength": 1,
          "description": "单次工具调用标识，用于和上层日志对账。"
        },
        "source_ip": {
          "type": "string",
          "minLength": 1,
          "description": "请求来源地址；本机或 unix socket 可填 local。"
        }
      },
      "allOf": [
        {
          "description": "Agent 发起时必须能定位到具体会话与工具调用。",
          "if": {
            "properties": {
              "type": {
                "const": "agent"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["session_id", "tool", "tool_call_id"]
          }
        }
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname"],
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "container_id": {
          "type": "string",
          "minLength": 1
        },
        "image_digest": {
          "$ref": "#/$defs/sha256",
          "description": "容器镜像摘要，用于证明执行环境不可变。"
        }
      }
    },
    "indirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["script_file", "inline_code", "module", "unknown"],
          "description": "间接执行的载体类型。"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "被解释器读取的文件路径。"
        },
        "sha256": {
          "$ref": "#/$defs/sha256",
          "description": "载体内容摘要；可读取时必须记录，内容本身不入日志。"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "载体字节数。"
        },
        "resolvable": {
          "type": "boolean",
          "description": "静态检查能否还原最终行为；false 表示执行内容在运行时才确定。"
        }
      },
      "allOf": [
        {
          "description": "文件型载体必须给出路径。",
          "if": {
            "properties": {
              "kind": {
                "const": "script_file"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["path"]
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "argv"],
      "properties": {
        "raw": {
          "type": "string",
          "minLength": 1,
          "description": "提交时的原始命令文本；敏感值就地脱敏，不整条丢弃。"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "解析后的参数数组，保留语义。"
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "description": "执行时的工作目录。"
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "description": "解析后的可执行文件路径。"
        },
        "indirection": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/indirection"
          },
          "description": "解释器间接执行的载体清单。"
        },
        "opaque_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "静态检查无法看穿的输入，例如 requirements.txt、setup.py。"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "phase",
        "policy_set",
        "policy_hash",
        "rule_id",
        "reason_code"
      ],
      "properties": {
        "result": {
          "enum": ["deny", "allow"]
        },
        "phase": {
          "enum": ["pre_exec", "post_exec"],
          "description": "判定发生的阶段。"
        },
        "policy_set": {
          "type": "string",
          "minLength": 1,
          "description": "策略集名称与版本，例如 prod-exec-allowlist@2026-10-20。"
        },
        "policy_hash": {
          "$ref": "#/$defs/sha256",
          "description": "策略集内容摘要，用于复现判定。"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "description": "命中的具体规则，例如 deny.interpreter_indirect_exec。"
        },
        "reason_code": {
          "enum": [
            "NOT_IN_ALLOWLIST",
            "OPAQUE_INTERPRETER_INPUT",
            "PATH_ESCAPE",
            "SHELL_METACHAR",
            "HARDLINE_PATTERN",
            "USER_DENIED",
            "APPROVAL_TIMEOUT",
            "POLICY_EVAL_ERROR"
          ],
          "description": "供告警聚合的稳定枚举；新增值需提升 schema_version。"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "给人看的自由文本说明，可随时调整文案。"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executed", "terminal_written", "side_effects"],
      "properties": {
        "executed": {
          "type": "boolean",
          "description": "命令是否实际开始执行。"
        },
        "terminal_written": {
          "type": "boolean",
          "description": "是否已写入终端会话。"
        },
        "side_effects": {
          "enum": ["none", "filesystem", "network", "process", "mixed", "unknown"],
          "description": "已观测到的副作用类别。"
        },
        "exit_code": {
          "type": ["integer", "null"],
          "description": "退出码；未执行时为 null。"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0,
          "description": "从接收到判定完成（或执行结束）的耗时。"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prev_hash", "record_hash", "signature"],
      "properties": {
        "prev_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "const": "",
              "description": "空串表示新链 genesis。"
            }
          ]
        },
        "record_hash": {
          "$ref": "#/$defs/sha256",
          "description": "本条记录的链式哈希。"
        },
        "signature": {
          "type": "string",
          "pattern": "^(ed25519|hmac-sha256):[A-Za-z0-9+/=_-]+$",
          "description": "对 record_hash 的签名，带算法前缀。"
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": "1.1",
      "event_id": "01J8Z3K7Q4V9R2M6T0X5B8N1C3",
      "seq": 1048577,
      "ts": "2026-10-24T09:14:32.118Z",
      "env": "prod",
      "event_type": "exec.denied",
      "actor": {
        "type": "agent",
        "id": "svc-deployer",
        "session_id": "cafac90a-a2d1-440e-9373-723fe8473bd0",
        "tool": "Bash",
        "tool_call_id": "call_7f3a9c21",
        "source_ip": "10.2.3.4"
      },
      "host": {
        "hostname": "prod-api-07",
        "container_id": "9d1c4e",
        "image_digest": "sha256:ab12cd34ef56ab78cd90ef12ab34cd56ef78ab90cd12ef34ab56cd78ef90ab12"
      },
      "command": {
        "raw": "pip install -r requirements.txt",
        "argv": ["pip", "install", "-r", "requirements.txt"],
        "cwd": "/srv/app",
        "executable": "/usr/local/bin/pip",
        "indirection": [
          {
            "kind": "script_file",
            "path": "requirements.txt",
            "sha256": "sha256:44e1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e7f",
            "bytes": 512,
            "resolvable": false
          }
        ],
        "opaque_inputs": ["requirements.txt", "setup.py (build backend)"]
      },
      "decision": {
        "result": "deny",
        "phase": "pre_exec",
        "policy_set": "prod-exec-allowlist@2026-10-20",
        "policy_hash": "sha256:9f2c8a1d4b6e0f3a5c7d9e1b2a4f6c8d0e2a4b6c8d0e2f4a6b8c0d2e4f6a8b0c",
        "rule_id": "deny.interpreter_indirect_exec",
        "reason_code": "OPAQUE_INTERPRETER_INPUT",
        "reason": "解释器参数在运行时才能解析，静态检查无法确定实际执行内容"
      },
      "outcome": {
        "executed": false,
        "terminal_written": false,
        "side_effects": "none",
        "exit_code": null,
        "latency_ms": 3
      },
      "integrity": {
        "prev_hash": "sha256:0c9d2e4f6a8b0c2d4e6f8a0b2c4d6e8f0a2b4c6d8e0f2a4b6c8d0e2f4a6b8c0d",
        "record_hash": "sha256:5a7e1c3b9d0f2e4a6c8b0d3f5a7e9c1b2d4f6a8c0e2b4d6f8a1c3e5b7d9f0a2c",
        "signature": "ed25519:MEUCIQDx7k3n5v9Q2w8e4r6t0y1u2i3o4p5a6s7d8f9g0h+jK/LmNo="
      }
    }
  ]
}
